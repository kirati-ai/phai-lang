# room_materials.apsi — คำนวณวัสดุห้องเดียว (พื้น · ผนัง · ฝ้า · คอนกรีตพื้น)
# หน่วยทุกตัวถูกตรวจก่อนรัน: เอา ตร.ม. ไปบวก ลบ.ม. = ไม่ยอมรัน

# ---------- ขนาดห้อง ----------
let width  = 4.0m
let length = 3.5m
let height = 2.6m

# ช่องเปิด (หักออกจากพื้นที่ผนัง)
let door_area   = 0.9m * 2.0m
let window_area = 1.2m * 1.2m

# ---------- สเปกวัสดุ (ราคาเป็นบาท = ตัวเลขเปล่า) ----------
let tile_per_box   = 0.6m * 0.6m * 4      # กระเบื้อง 60×60 ซม. กล่องละ 4 แผ่น
let tile_waste     = 0.05                 # เผื่อเศษ 5%
let tile_price     = 450                  # บาท/กล่อง

let paint_cover    = 10[m^2/L]            # 1 ลิตร ทาได้ 10 ตร.ม. ต่อรอบ
let paint_coats    = 2
let paint_bucket   = 9L                   # สีถังละ 9 ลิตร
let paint_price    = 1650                 # บาท/ถัง

let board_area     = 1.2m * 2.4m          # แผ่นยิปซัม 1.20×2.40 ม.
let board_waste    = 0.10
let board_price    = 210                  # บาท/แผ่น

let slab_thick     = 10[cm]
let concrete_step  = 0.5[m^3]             # สั่งคอนกรีตผสมเสร็จทีละครึ่งคิว
let concrete_price = 2400                 # บาท/คิว

# ---------- สูตร ----------
fn pieces(need: Area, per_piece: Area, waste: Float) -> Int =
    ceil(need * (1 + waste) / per_piece)

let floor_area = width * length
let wall_area  = 2 * (width + length) * height - door_area - window_area
let ceil_area  = floor_area

let tile_boxes   = pieces(floor_area, tile_per_box, tile_waste)
let paint_liters = wall_area * paint_coats / paint_cover
let paint_cans   = ceil(paint_liters / paint_bucket)
let boards       = pieces(ceil_area, board_area, board_waste)
let slab_volume  = floor_area * slab_thick
let concrete_cue = ceil(slab_volume / concrete_step) * 0.5   # จำนวนคิวที่สั่งจริง

# ---------- ผลลัพธ์ ----------
print(f"พื้นที่พื้น      {floor_area as [m^2]:.2f}")
print(f"พื้นที่ผนังสุทธิ  {wall_area as [m^2]:.2f}")
print(f"ปริมาตรพื้นคอนกรีต {slab_volume as [m^3]:.3f}")
print("")
print(f"1. กระเบื้อง 60×60   {tile_boxes} กล่อง   = {tile_boxes * tile_price:,} บาท")
print(f"2. สีทาผนัง {paint_coats} รอบ    {paint_liters as [L]:.1f} → {paint_cans} ถัง = {paint_cans * paint_price:,} บาท")
print(f"3. ยิปซัมฝ้า         {boards} แผ่น   = {boards * board_price:,} บาท")
print(f"4. คอนกรีตพื้น        {concrete_cue} คิว  = {concrete_cue * concrete_price:,.0f} บาท")

let total = tile_boxes * tile_price + paint_cans * paint_price + boards * board_price + concrete_cue * concrete_price
print("")
print(f"รวมค่าวัสดุ {total:,.2f} บาท")

test "ตัวเลขสมเหตุสมผล":
    assert floor_area ~= 14[m^2]
    assert wall_area < 2 * (width + length) * height   # หักประตู/หน้าต่างแล้ว
    assert tile_boxes * tile_per_box >= floor_area      # กระเบื้องพอปู
    assert paint_cans * paint_bucket >= paint_liters    # สีพอทา
